{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "profile": {
      "type": "string",
      "enum": [
        "tecnico",
        "supply",
        "gestor"
      ],
      "description": "Perfil funcional no CSOP"
    },
    "sector": {
      "type": "string",
      "enum": [
        "Produ\u00e7\u00e3o",
        "Expedi\u00e7\u00e3o",
        "Qualidade",
        "Almoxarifado",
        "Mistura",
        "PCP",
        "Envase"
      ]
    }
  },
  "required": [
    "role"
  ]
}