{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "profile": {
      "type": "string",
      "enum": [
        "tecnico",
        "supply",
        "lider"
      ],
      "description": "Perfil funcional no CSOP"
    },
    "area": {
      "type": "string",
      "enum": [
        "Pasta",
        "P\u00f3",
        "Sach\u00ea",
        "L\u00edquido"
      ],
      "description": "\u00c1rea de produ\u00e7\u00e3o vinculada ao usu\u00e1rio"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo/fun\u00e7\u00e3o do usu\u00e1rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo"
    }
  },
  "required": [
    "role"
  ]
}