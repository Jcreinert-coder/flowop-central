{
  "name": "ProductionRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string"
    },
    "op_number": {
      "type": "string"
    },
    "technician_name": {
      "type": "string"
    },
    "tech_user_id": {
      "type": "string"
    },
    "sector": {
      "type": "string",
      "enum": [
        "Produ\u00e7\u00e3o",
        "Expedi\u00e7\u00e3o",
        "Qualidade",
        "Almoxarifado",
        "Mistura",
        "PCP",
        "Envase"
      ]
    },
    "product": {
      "type": "string"
    },
    "product_code": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "caixas",
        "pacotes",
        "unidades",
        "litros"
      ]
    },
    "reason": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Normal",
        "Urgente"
      ],
      "default": "Normal"
    },
    "observations": {
      "type": "string"
    },
    "supply_notes": {
      "type": "string"
    },
    "supply_responsible": {
      "type": "string"
    },
    "supply_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Recebida",
        "Em Atendimento",
        "OP Criada",
        "Em Produ\u00e7\u00e3o",
        "Apontada",
        "Finalizada",
        "Cancelada"
      ],
      "default": "Recebida"
    },
    "request_date": {
      "type": "string",
      "format": "date"
    },
    "request_time": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "user": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "request_number",
    "technician_name",
    "sector",
    "product",
    "quantity",
    "unit",
    "reason",
    "priority",
    "status"
  ]
}