{
  "name": "ProductionRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string"
    },
    "op_number": {
      "type": "string"
    },
    "technician_name": {
      "type": "string"
    },
    "tech_user_id": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "enum": [
        "Pasta",
        "P\u00f3",
        "Sach\u00ea",
        "L\u00edquido",
        "Mistura Fina",
        "Envase Especiais"
      ]
    },
    "etapa": {
      "type": "string",
      "enum": [
        "Mistura Fina",
        "Semiacabado",
        "Produto Acabado"
      ],
      "description": "Etapa do processo produtivo"
    },
    "product": {
      "type": "string"
    },
    "product_code": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "caixas",
        "pacotes",
        "unidades",
        "litros"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "Alinhamento Semanal",
        "Altera\u00e7\u00e3o de Programa\u00e7\u00e3o"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "Normal",
        "Urgente"
      ],
      "default": "Normal"
    },
    "observations": {
      "type": "string"
    },
    "supply_notes": {
      "type": "string"
    },
    "supply_responsible": {
      "type": "string"
    },
    "supply_user_id": {
      "type": "string"
    },
    "produced_quantity": {
      "type": "number",
      "description": "Quantidade efetivamente produzida (apontamento)"
    },
    "production_date": {
      "type": "string",
      "format": "date",
      "description": "Data do apontamento de produ\u00e7\u00e3o"
    },
    "production_time": {
      "type": "string",
      "description": "Hora do apontamento de produ\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planejada",
        "Aguardando Emiss\u00e3o da OP",
        "OP Emitida",
        "Em Produ\u00e7\u00e3o",
        "Apontada",
        "Finalizada",
        "Cancelada"
      ],
      "default": "Planejada"
    },
    "request_date": {
      "type": "string",
      "format": "date"
    },
    "request_time": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "user": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "request_number",
    "technician_name",
    "area",
    "product",
    "quantity",
    "unit",
    "reason",
    "priority",
    "status"
  ]
}